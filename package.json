{
  "name": "exam2pdf",
  "version": "0.1.4-preview.1",
  "private": true,
  "description": "家卷 · 家庭试卷工作台",
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "npm run electron:install",
    "electron:install": "node node_modules/electron/install.js",
    "start": "node scripts/start-electron.cjs",
    "test": "node --test electron/*.test.cjs frontend/*.test.cjs scripts/*.test.cjs",
    "test:desktop": "node scripts/check-desktop.cjs",
    "smoke:startup": "node scripts/start-electron.cjs --startup-smoke",
    "test:store": "node --test electron/post-store.test.cjs",
    "dist:mac": "node scripts/package-app.cjs mac",
    "dist:win": "node scripts/package-app.cjs win",
    "dist:linux": "node scripts/package-app.cjs linux",
    "test:pdf": "node scripts/check-pdf-import.cjs"
  },
  "build": {
    "afterPack": "scripts/after-pack.cjs",
    "appId": "com.exam2pdf.desktop",
    "productName": "exam2pdf",
    "asar": true,
    "files": [
      "electron/**/*",
      "docs/原型图.html",
      "frontend/page-reorder.js",
      "frontend/exam2pdf.user.js",
      "scripts/start-electron.cjs",
      "package.json",
      "README.md",
      "LICENSE",
      "node_modules/katex/dist/katex.min.css",
      "node_modules/katex/dist/katex.min.js",
      "node_modules/katex/dist/contrib/auto-render.min.js",
      "node_modules/katex/dist/fonts/*",
      "build/icon.png",
      "!electron/**/*.test.cjs",
      "node_modules/pdfjs-dist/build/*.mjs",
      "node_modules/pdfjs-dist/cmaps/**/*",
      "node_modules/pdfjs-dist/standard_fonts/**/*",
      "node_modules/pdfjs-dist/wasm/**/*",
      "node_modules/pdfjs-dist/iccs/**/*",
      "node_modules/pdfjs-dist/LICENSE",
      "!node_modules/@napi-rs/**/*",
      "THIRD_PARTY_NOTICES.md",
      "node_modules/katex/LICENSE",
      "!**/node_modules/pdfjs-dist/{legacy,web,types,image_decoders}/**/*",
      "!**/node_modules/pdfjs-dist/**/*.map",
      "!**/node_modules/pdfjs-dist/build/{pdf.min.mjs,pdf.worker.min.mjs,pdf.sandbox*.mjs}",
      "!**/node_modules/pdfjs-dist/{webpack.mjs,CODE_OF_CONDUCT.md}",
      "!**/node_modules/katex/{src,types,contrib}/**/*",
      "!**/node_modules/katex/{cli.js,katex.ts}",
      "!**/node_modules/katex/dist/{katex.js,katex.mjs,katex.css}",
      "!**/node_modules/katex/dist/**/*.map",
      "!**/node_modules/katex/dist/fonts/*.{ttf,woff}",
      "!**/node_modules/katex/dist/contrib/!(auto-render.min.js)",
      "frontend/student-focus.js",
      "frontend/assets/avatars/*.jpg"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "exam2pdf"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "maintainer": "nerkeler <nerkeler@users.noreply.github.com>",
      "icon": "build/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "nerkeler",
      "repo": "exam2pdf"
    },
    "compression": "maximum",
    "electronLanguages": [
      "en",
      "zh-CN",
      "zh-TW"
    ]
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "26.17.0",
    "js-yaml": "4.3.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "katex": "^0.19.1",
    "pdfjs-dist": "6.4.299",
    "qrcode": "1.5.4"
  },
  "author": "nerkeler",
  "homepage": "https://github.com/nerkeler/exam2pdf",
  "repository": {
    "type": "git",
    "url": "https://github.com/nerkeler/exam2pdf.git"
  },
  "bugs": {
    "url": "https://github.com/nerkeler/exam2pdf/issues"
  }
}
